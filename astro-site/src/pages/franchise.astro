<script type="application/json" id="nav-location-data" set:html={JSON.stringify(navLocations)}></script>
<script>
var navLocationDataNode = document.getElementById('nav-location-data');
var navLocationData = navLocationDataNode ? JSON.parse(navLocationDataNode.textContent || '[]') : [];
var navLocationStorageKey = 'pw_selected_location';
var navLocationPendingOrder = null;
var navLocationCoords = null;
function getNavLocation(id){
  return navLocationData.find(function(location){ return location.id === id; });
}
function navLocationDistance(lat1,lng1,lat2,lng2){
  var earthRadius = 3959;
  var dLat = (lat2 - lat1) * Math.PI / 180;
  var dLng = (lng2 - lng1) * Math.PI / 180;
  var a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
    Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
    Math.sin(dLng / 2) * Math.sin(dLng / 2);
  return earthRadius * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
}
function setNavLocation(location){
  if(!location) return;
  localStorage.setItem(navLocationStorageKey, JSON.stringify(location));
  var title = document.querySelector('[data-location-trigger-title]');
  if(title) title.textContent = location.name + ', ' + location.state;
  var status = document.querySelector('[data-nav-location-status]');
  if(status) status.textContent = 'Selected ' + location.name + '. Order Now will use this store.';
  document.querySelectorAll('[data-nav-location-card]').forEach(function(card){
    card.classList.toggle('selected', card.getAttribute('data-location-id') === location.id);
  });
}
function openNavLocationDropdown(){
  var dropdown = document.querySelector('[data-location-dropdown]');
  var trigger = document.querySelector('[data-location-trigger]');
  if(dropdown) dropdown.classList.add('open');
  if(trigger) trigger.setAttribute('aria-expanded','true');
  window.setTimeout(function(){
    var input = document.querySelector('[data-nav-location-search]');
    if(input) input.focus();
  }, 50);
}
function closeNavLocationDropdown(){
  var dropdown = document.querySelector('[data-location-dropdown]');
  var trigger = document.querySelector('[data-location-trigger]');
  if(dropdown) dropdown.classList.remove('open');
  if(trigger) trigger.setAttribute('aria-expanded','false');
}
function filterNavLocations(){
  var input = document.querySelector('[data-nav-location-search]');
  var q = input ? input.value.trim().toLowerCase() : '';
  var visible = 0;
  document.querySelectorAll('[data-nav-location-card]').forEach(function(card){
    var location = getNavLocation(card.getAttribute('data-location-id'));
    if(!location) return;
    var haystack = [location.name, location.address, location.city, location.state, location.zip, location.type].join(' ').toLowerCase();
    var match = !q || haystack.indexOf(q) !== -1;
    card.classList.toggle('hidden', !match);
    visible += match ? 1 : 0;
  });
  var status = document.querySelector('[data-nav-location-status]');
  if(status && q) status.textContent = visible ? visible + ' matching location' + (visible === 1 ? '' : 's') + '.' : 'No matching locations found.';
}
function updateNavDistances(){
  if(!navLocationCoords) return;
  var list = document.querySelector('[data-nav-location-list]');
  var cards = Array.prototype.slice.call(document.querySelectorAll('[data-nav-location-card]'));
  cards.forEach(function(card){
    var location = getNavLocation(card.getAttribute('data-location-id'));
    if(!location) return;
    var miles = navLocationDistance(navLocationCoords.lat, navLocationCoords.lng, location.lat, location.lng);
    card.dataset.distance = String(miles);
    var distance = card.querySelector('[data-nav-distance-for]');
    if(distance) distance.textContent = miles.toFixed(1) + ' miles';
  });
  cards.sort(function(a,b){ return parseFloat(a.dataset.distance || '999999') - parseFloat(b.dataset.distance || '999999'); });
  cards.forEach(function(card){ if(list) list.appendChild(card); });
  var nearest = cards[0] ? getNavLocation(cards[0].getAttribute('data-location-id')) : null;
  if(nearest) setNavLocation(nearest);
}
function openNavOrderModal(location){
  var modal = document.querySelector('[data-nav-order-modal]');
  var modalLocation = document.querySelector('[data-nav-modal-location]');
  var status = document.querySelector('[data-nav-location-status]');
  if(!location || !location.orderUrl){
    if(status) status.textContent = 'That location is marked Coming Soon, so online ordering is not active yet.';
    openNavLocationDropdown();
    return;
  }
  navLocationPendingOrder = location;
  setNavLocation(location);
  if(modalLocation) modalLocation.textContent = location.name + ', ' + location.state;
  if(modal){
    modal.classList.add('open');
    modal.setAttribute('aria-hidden','false');
  }
}
function closeNavOrderModal(){
  var modal = document.querySelector('[data-nav-order-modal]');
  if(modal){
    modal.classList.remove('open');
    modal.setAttribute('aria-hidden','true');
  }
}
var navLocationTrigger = document.querySelector('[data-location-trigger]');
if(navLocationTrigger){
  navLocationTrigger.addEventListener('click', function(){
    var dropdown = document.querySelector('[data-location-dropdown]');
    if(dropdown && dropdown.classList.contains('open')) closeNavLocationDropdown();
    else openNavLocationDropdown();
  });
}
var navLocationSearch = document.querySelector('[data-nav-location-search]');
if(navLocationSearch) navLocationSearch.addEventListener('input', filterNavLocations);
var navUseLocation = document.querySelector('[data-nav-use-location]');
if(navUseLocation){
  navUseLocation.addEventListener('click', function(){
    var status = document.querySelector('[data-nav-location-status]');
    if(!navigator.geolocation){
      if(status) status.textContent = 'Current location is not supported by this browser.';
      return;
    }
    navUseLocation.textContent = 'Locating...';
    navUseLocation.disabled = true;
    navigator.geolocation.getCurrentPosition(function(position){
      navLocationCoords = {lat: position.coords.latitude, lng: position.coords.longitude};
      updateNavDistances();
      filterNavLocations();
      if(status) status.textContent = 'Nearest Pizza World selected. You can still choose a different store.';
      navUseLocation.textContent = 'Use Current Location';
      navUseLocation.disabled = false;
    }, function(){
      if(status) status.textContent = 'Could not get your current location. Search by city, state, or ZIP instead.';
      navUseLocation.textContent = 'Use Current Location';
      navUseLocation.disabled = false;
    }, {enableHighAccuracy:true,timeout:10000,maximumAge:300000});
  });
}
document.addEventListener('click', function(event){
  if(event.target.closest('[data-nav-location]')) return;
  if(event.target.closest('[data-nav-order-modal]')) return;
  closeNavLocationDropdown();
});
document.addEventListener('click', function(event){
  var select = event.target.closest('[data-nav-select-location]');
  if(select){
    setNavLocation(getNavLocation(select.getAttribute('data-nav-select-location')));
    closeNavLocationDropdown();
    return;
  }
  var order = event.target.closest('[data-nav-order-location]');
  if(order){
    openNavOrderModal(getNavLocation(order.getAttribute('data-nav-order-location')));
    return;
  }
  if(event.target.closest('[data-nav-order-selected]')){
    event.preventDefault();
    var selected = null;
    try { selected = JSON.parse(localStorage.getItem(navLocationStorageKey) || 'null'); } catch(error) {}
    if(!selected){
      var status = document.querySelector('[data-nav-location-status]');
      if(status) status.textContent = 'Choose a Pizza World location first, then Order Now will go to that store.';
      openNavLocationDropdown();
      return;
    }
    openNavOrderModal(getNavLocation(selected.id) || selected);
    return;
  }
  if(event.target.closest('[data-nav-close-order]')) closeNavOrderModal();
});
var navConfirmOrder = document.querySelector('[data-nav-confirm-order]');
if(navConfirmOrder){
  navConfirmOrder.addEventListener('click', function(){
    if(navLocationPendingOrder && navLocationPendingOrder.orderUrl){
      window.open(navLocationPendingOrder.orderUrl, '_blank', 'noopener');
    }
    closeNavOrderModal();
  });
}
try {
  var storedNavLocation = JSON.parse(localStorage.getItem(navLocationStorageKey) || 'null');
  if(storedNavLocation && storedNavLocation.id) setNavLocation(getNavLocation(storedNavLocation.id) || storedNavLocation);
} catch(error) {}
document.addEventListener('keydown', function(event){
  if(event.key === 'Escape'){
    closeNavLocationDropdown();
    closeNavOrderModal();
  }
});
var navToggle = document.querySelector('.nav-toggle');
var navLinks = document.querySelector('.nav-links');
if (navToggle && navLinks) {
  navToggle.addEventListener('click', function(){
    var open = navLinks.classList.toggle('open');
    navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  navLinks.querySelectorAll('a').forEach(function(link){
    link.addEventListener('click', function(){
      navLinks.classList.remove('open');
      navToggle.setAttribute('aria-expanded', 'false');
    });
  });
}
var franchiseAnswers = [
  {keys:['cost','investment','startup'],answer:'A standard Pizza World store is currently presented around $138K–$286K estimated startup cost. The C-Store concept is shown around $92K–$232K. The initial franchise fee is listed as $19,500. Final costs depend on site, size, buildout, equipment, market, and the official franchise documents.'},
  {keys:['royalty','royalties','marketing fee','fees','fee'],answer:'Pizza World promotes a 2.75% royalty on net sales and no required marketing fund contribution. Franchisees still need to invest in local marketing for their own market. Official documents control final fee obligations.'},
  {keys:['training','support','help','operations'],answer:'Training includes a virtual training program before store training, about two weeks of hands-on training at a designated Pizza World location, opening support, operational guidance, approved specs, marketing resources, and ongoing access to training materials for new employees.'},
  {keys:['long','timeline','time','construction','open'],answer:'Construction is typically presented around 90–120 days depending on location, store format, permits, buildout, equipment, and readiness. Site selection, lease timing, financing, and construction approvals can affect the timeline.'},
  {keys:['experience','restaurant','ownership','background'],answer:'Restaurant experience can help, but the opportunity is designed around training, systems, and support. The stronger questions are whether the candidate has the right capital, work ethic, leadership ability, and willingness to follow the Pizza World system.'},
  {keys:['territory','market','available','city','state','area'],answer:'Territories are available in select markets. Availability depends on the target area, current development plans, and Pizza World approval. A franchise representative would confirm whether a specific city or territory is open.'},
  {keys:['equipment','supplier','suppliers','buildout'],answer:'Pizza World provides buildout guidance, equipment specifications, approved supplier direction, and system standards. Franchisees may be required to use designated or approved suppliers so stores stay consistent with brand standards.'},
  {keys:['financing','sba','loan','bank'],answer:'Pizza World is presented as SBA approved, so qualified candidates may be able to pursue SBA financing through participating lenders. Financing depends on the applicant, lender, credit, capital, and full project scope.'},
  {keys:['request','info','apply','contact','call','representative','next step'],answer:'Great — the next step is to share your name, contact info, market of interest, timeline, available capital range, and any restaurant/business experience. I can help prepare that inquiry now.'}
];
function addChatMessage(text, who){
  var chat = document.getElementById('chatWindow');
  if(!chat) return;
  var msg = document.createElement('div');
  msg.className = 'chat-message ' + (who || 'bot');
  var bubble = document.createElement('div');
  bubble.className = 'bubble';
  bubble.textContent = text;
  msg.appendChild(bubble);
  chat.appendChild(msg);
  chat.scrollTop = chat.scrollHeight;
}
function getAssistantAnswer(question){
  var q = String(question || '').toLowerCase();
  for(var i=0;i<franchiseAnswers.length;i++){
    if(franchiseAnswers[i].keys.some(function(k){ return q.indexOf(k) !== -1; })) return franchiseAnswers[i].answer;
  }
  return 'Good question. I can help with general franchise topics like investment, royalties, training, support, opening timeline, territories, financing, equipment, and next steps. For exact legal or territory details, a Pizza World franchise representative should confirm from the official documents.';
}
function askAssistant(question){
  if(!question || !question.trim()) return;
  addChatMessage(question.trim(), 'user');
  window.setTimeout(function(){
    var answer = getAssistantAnswer(question);
    addChatMessage(answer, 'bot');
    if(/request|info|apply|contact|call|representative|next step/i.test(question)){
      var lead = document.getElementById('leadCapture');
      if(lead) lead.classList.add('open');
    }
  }, 250);
}
var assistantForm = document.getElementById('assistantForm');
var assistantInput = document.getElementById('assistantInput');
if(assistantForm && assistantInput){
  assistantForm.addEventListener('submit', function(e){
    e.preventDefault();
    var q = assistantInput.value;
    assistantInput.value = '';
    askAssistant(q);
  });
}
document.querySelectorAll('#quickPrompts button').forEach(function(btn){
  btn.addEventListener('click', function(){ askAssistant(btn.getAttribute('data-question')); });
});
var floatingAssistant = document.getElementById('floatingAssistant');
if(floatingAssistant){
  floatingAssistant.addEventListener('click', function(){
    document.getElementById('franchise-assistant').scrollIntoView({behavior:'smooth',block:'start'});
    window.setTimeout(function(){ if(assistantInput) assistantInput.focus(); }, 550);
  });
}
var leadSubmit = document.getElementById('leadSubmit');
if(leadSubmit){
  leadSubmit.addEventListener('click', function(){
    var summary = 'Franchise inquiry prepared: ' +
      (document.getElementById('leadName').value || 'Name not provided') + ' | ' +
      (document.getElementById('leadPhone').value || 'Phone not provided') + ' | ' +
      (document.getElementById('leadEmail').value || 'Email not provided') + ' | Market: ' +
      (document.getElementById('leadMarket').value || 'Not provided') + ' | Capital: ' +
      (document.getElementById('leadCapital').value || 'Not provided') + '. Please submit the main form below or call (417) 730-1177.';
    addChatMessage(summary, 'bot');
    document.getElementById('contact').scrollIntoView({behavior:'smooth',block:'start'});
  });
}
</script>
