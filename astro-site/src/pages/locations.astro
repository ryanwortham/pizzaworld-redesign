<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pizza World Locations - Find Pizza Near You</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta name="description" content="Find your nearest Pizza World location, choose your store, get directions, and order online.">
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Open+Sans:wght@300;400;600;700&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--red:#c41e2a;--red2:#e63946;--dark:#0a0a0a;--dark2:#121212;--dark3:#1a1a1a;--gold:#c9a84c;--white:#fff;--gray:#94a3b8;--muted:#64748b;--green:#22c55e}
html{scroll-behavior:smooth}
body{font-family:'Open Sans',sans-serif;background:var(--dark);color:var(--white);overflow-x:hidden}
button,input,select{font:inherit}
a{color:inherit}
.site-nav{position:sticky;top:0;z-index:50;background:rgba(10,10,10,.97);backdrop-filter:blur(12px);border-bottom:2px solid var(--red);height:72px;display:flex;align-items:center;justify-content:space-between;padding:0 clamp(16px,3vw,40px);gap:18px}
.site-nav img{height:50px;filter:brightness(0) invert(1)}
.nav-actions{display:flex;align-items:center;gap:10px}
.selected-store{display:flex;align-items:center;gap:9px;border:1px solid rgba(255,255,255,.15);background:#111;border-radius:999px;color:#fff;padding:9px 14px;font-size:12px;line-height:1;text-transform:uppercase;letter-spacing:1.2px;font-family:'Oswald',sans-serif}
.selected-store span{color:var(--gold);max-width:190px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.nav-link{font-family:'Oswald',sans-serif;text-transform:uppercase;text-decoration:none;letter-spacing:1.4px;font-size:12px;color:#ddd;padding:10px 12px;border-radius:5px}
.nav-link:hover{background:rgba(255,255,255,.05);color:#fff}
.order-link{border:0;background:var(--red);color:#fff;font-family:'Oswald',sans-serif;text-transform:uppercase;letter-spacing:1.5px;border-radius:5px;padding:12px 18px;cursor:pointer;text-decoration:none;white-space:nowrap}
.order-link:hover{background:var(--red2)}
.hero{position:relative;min-height:58vh;display:flex;align-items:flex-end;padding:116px clamp(18px,5vw,64px) 54px;background:linear-gradient(135deg,rgba(10,10,10,.72),rgba(10,10,10,.44)),url('/img/hero-pizza.jpg') center/cover}
.hero-copy{max-width:820px}
.eyebrow,.section-label{font-family:'Oswald',sans-serif;font-size:12px;letter-spacing:4px;text-transform:uppercase;color:var(--gold);display:block;margin-bottom:12px}
h1{font-family:'Oswald',sans-serif;font-size:clamp(42px,7vw,84px);line-height:1;text-transform:uppercase;letter-spacing:1px}
h1 span,.section-title span{color:var(--red2)}
.hero p{margin-top:18px;max-width:650px;color:rgba(255,255,255,.76);font-size:17px;line-height:1.75}
.finder-shell{display:grid;grid-template-columns:minmax(360px,680px) minmax(360px,1fr);gap:0;min-height:calc(100vh - 72px);background:var(--dark2);border-top:1px solid #1f1f1f}
.finder-panel{padding:34px clamp(18px,4vw,44px) 44px;border-right:1px solid #222}
.panel-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:24px}
.section-title{font-family:'Oswald',sans-serif;text-transform:uppercase;font-size:clamp(28px,4vw,46px);line-height:1.1}
.result-count{font-family:'Oswald',sans-serif;color:#cbd5e1;font-size:13px;text-transform:uppercase;letter-spacing:1.3px;white-space:nowrap;margin-top:11px}
.selected-banner{display:none;background:#151515;border:1px solid rgba(201,168,76,.45);border-left:4px solid var(--gold);padding:14px 16px;margin-bottom:18px;border-radius:8px;color:#d6d3c6;font-size:13px;line-height:1.55}
.selected-banner strong{color:#fff}
.selected-banner.open{display:block}
.controls{display:grid;grid-template-columns:1fr auto;gap:10px;margin-bottom:12px}
.search-input{position:relative}
.search-input input{width:100%;height:52px;border-radius:8px;border:1px solid #2b2b2b;background:#080808;color:#fff;padding:0 16px 0 42px;font-size:15px}
.search-input input:focus,.state-filter:focus{outline:none;border-color:var(--gold)}
.search-input::before{content:'';position:absolute;left:16px;top:50%;width:15px;height:15px;border:2px solid var(--red2);border-radius:50%;transform:translateY(-58%)}
.search-input::after{content:'';position:absolute;left:29px;top:31px;width:8px;height:2px;background:var(--red2);transform:rotate(45deg);border-radius:4px}
.use-location{height:52px;border:0;border-radius:8px;background:var(--red);color:#fff;font-family:'Oswald',sans-serif;text-transform:uppercase;letter-spacing:1.4px;padding:0 18px;cursor:pointer;white-space:nowrap}
.use-location:hover{background:var(--red2)}
.filters{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:20px}
.state-filter,.quick-filter{height:42px;border-radius:999px;border:1px solid #292929;background:#0b0b0b;color:#dbe2ea;padding:0 14px;font-size:13px}
.quick-filter{cursor:pointer}
.quick-filter.active{background:var(--red);border-color:var(--red);color:#fff}
.status-line{min-height:22px;color:var(--gray);font-size:13px;line-height:1.55;margin-bottom:12px}
.locations-list{display:flex;flex-direction:column;gap:14px;max-height:820px;overflow:auto;padding-right:8px}
.locations-list::-webkit-scrollbar{width:8px}.locations-list::-webkit-scrollbar-track{background:#1e1e1e;border-radius:999px}.locations-list::-webkit-scrollbar-thumb{background:var(--red);border-radius:999px}
.location-card{background:#0b0b0c;border:1px solid #222;border-radius:8px;padding:20px;display:grid;grid-template-columns:1fr auto;gap:18px;transition:border-color .2s,transform .2s,background .2s}
.location-card:hover,.location-card.selected{border-color:var(--red);background:#101012}
.location-card.selected{box-shadow:0 0 0 1px rgba(196,30,42,.35)}
.location-main h2{font-family:'Oswald',sans-serif;text-transform:uppercase;font-size:24px;letter-spacing:.8px;margin-bottom:8px}
.meta-row{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:13px}
.pill{display:inline-flex;align-items:center;height:28px;border-radius:999px;background:rgba(255,255,255,.08);color:#cbd5e1;font-family:'Oswald',sans-serif;text-transform:uppercase;letter-spacing:1.1px;font-size:11px;padding:0 10px}
.pill.open{background:rgba(34,197,94,.16);color:#a7f3d0}.pill.soon{background:rgba(201,168,76,.16);color:#fde68a}
.location-card p{color:#b4c0cd;font-size:14px;line-height:1.65;margin-bottom:8px}
.location-card a.text-link{color:var(--gold);font-size:13px;text-decoration:none;font-weight:700}
.location-card a.text-link:hover{text-decoration:underline}
.distance{font-family:'Oswald',sans-serif;color:#fff;font-size:18px;text-align:right;white-space:nowrap}
.card-actions{display:flex;gap:10px;align-items:center;justify-content:flex-end;margin-top:18px;flex-wrap:wrap}
.small-btn{border:1px solid #2e2e2e;background:#141414;color:#fff;border-radius:5px;padding:10px 12px;text-decoration:none;font-size:12px;font-family:'Oswald',sans-serif;text-transform:uppercase;letter-spacing:1.1px;cursor:pointer}
.small-btn:hover{border-color:#fff}.small-btn.primary{background:var(--red);border-color:var(--red)}.small-btn.primary:hover{background:var(--red2);border-color:var(--red2)}
.small-btn[disabled]{opacity:.46;cursor:not-allowed;background:#141414;border-color:#2e2e2e}
.map-panel{position:sticky;top:72px;height:calc(100vh - 72px);min-height:620px;background:radial-gradient(circle at 28% 22%,rgba(196,30,42,.22),transparent 28%),radial-gradient(circle at 72% 62%,rgba(201,168,76,.16),transparent 28%),#080808;padding:34px;display:flex;align-items:center;justify-content:center}
.map-card{position:relative;width:min(100%,740px);height:min(78vh,760px);min-height:520px;border:1px solid #262626;border-radius:10px;overflow:hidden;background:linear-gradient(135deg,#151515,#0d0d0e);box-shadow:0 30px 100px rgba(0,0,0,.45)}
.map-card::before{content:'';position:absolute;inset:0;background:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);background-size:38px 38px;mask-image:radial-gradient(circle at 50% 48%,#000 0 72%,transparent 100%)}
.map-card::after{content:'Florida | Midwest | Branson Lakes';position:absolute;left:22px;bottom:18px;color:#5f6b79;font-family:'Oswald',sans-serif;text-transform:uppercase;letter-spacing:1.8px;font-size:11px}
.map-pin{position:absolute;width:34px;height:34px;border:0;border-radius:50% 50% 50% 6px;background:var(--red);transform:translate(-50%,-50%) rotate(-45deg);box-shadow:0 10px 26px rgba(0,0,0,.38);cursor:pointer;transition:transform .2s,background .2s}
.map-pin::after{content:'';position:absolute;inset:9px;border-radius:50%;background:#fff}
.map-pin span{position:absolute;left:26px;top:28px;transform:rotate(45deg);background:#0b0b0c;border:1px solid #282828;color:#fff;border-radius:5px;padding:5px 8px;font-family:'Oswald',sans-serif;text-transform:uppercase;font-size:10px;letter-spacing:.8px;white-space:nowrap;opacity:0;pointer-events:none;transition:opacity .2s}
.map-pin:hover,.map-pin.active{background:var(--gold);transform:translate(-50%,-50%) rotate(-45deg) scale(1.08)}.map-pin:hover span,.map-pin.active span{opacity:1}
.map-summary{position:absolute;top:20px;left:20px;right:20px;background:rgba(8,8,8,.88);border:1px solid #262626;border-radius:8px;padding:18px;backdrop-filter:blur(12px)}
.map-summary h2{font-family:'Oswald',sans-serif;text-transform:uppercase;font-size:24px;margin-bottom:8px}.map-summary p{font-size:13px;color:var(--gray);line-height:1.65}
.modal{position:fixed;inset:0;z-index:80;display:none;align-items:center;justify-content:center;padding:18px}
.modal.open{display:flex}
.modal-backdrop{position:absolute;inset:0;background:rgba(0,0,0,.78)}
.modal-card{position:relative;width:min(100%,440px);background:#101012;border:1px solid #2b2b2b;border-top:4px solid var(--red);border-radius:10px;padding:26px;box-shadow:0 30px 90px rgba(0,0,0,.55)}
.modal-card h2{font-family:'Oswald',sans-serif;text-transform:uppercase;font-size:28px;margin-bottom:10px}.modal-card p{color:#cbd5e1;line-height:1.7;font-size:14px;margin-bottom:18px}.modal-location{color:var(--gold);font-weight:700}
.modal-actions{display:flex;gap:10px;justify-content:flex-end;flex-wrap:wrap}.modal-actions button{border-radius:5px;padding:12px 15px;font-family:'Oswald',sans-serif;letter-spacing:1.2px;text-transform:uppercase;cursor:pointer;border:1px solid #2f2f2f;background:#161616;color:#fff}.modal-actions .confirm{background:var(--red);border-color:var(--red)}
.no-results{display:none;background:#0b0b0c;border:1px dashed #353535;border-radius:8px;padding:22px;color:#cbd5e1;line-height:1.6}
.no-results.open{display:block}
@media(max-width:1040px){.finder-shell{grid-template-columns:1fr}.finder-panel{border-right:0}.map-panel{position:relative;top:0;height:auto;min-height:560px}.locations-list{max-height:none}.nav-actions{gap:6px}.selected-store{display:none}}
@media(max-width:640px){.site-nav{height:auto;min-height:72px;flex-wrap:wrap;padding-top:10px;padding-bottom:10px}.nav-actions{width:100%;justify-content:space-between}.hero{padding-top:72px}.controls{grid-template-columns:1fr}.use-location{width:100%}.location-card{grid-template-columns:1fr}.distance{text-align:left}.card-actions{justify-content:flex-start}.map-panel{padding:18px}.map-card{min-height:500px}.nav-link{padding-left:0}}
</style>
</head>
<body>
<nav class="site-nav" aria-label="Main navigation">
  <a href="franchise.html" aria-label="Pizza World home"><img src="https://mypizzaworld.net/wp-content/uploads/2024/02/PW-NEW-logo-1996-R-1.png" alt="Pizza World"></a>
  <div class="nav-actions">
    <a class="nav-link" href="franchise.html">Franchise</a>
    <div class="selected-store">Store: <span data-selected-store-name>Select Location</span></div>
    <button class="order-link" type="button" data-order-selected>Order Now</button>
  </div>
</nav>

<header class="hero">
  <div class="hero-copy">
    <span class="eyebrow">Pizza World Locations</span>
    <h1>Find Your <span>Pizza World</span></h1>
    <p>Search by city, state, or ZIP, use your current location to sort by distance, choose a store, and every order button will remember the location you selected.</p>
  </div>
</header>

<main class="finder-shell">
  <section class="finder-panel" aria-labelledby="locations-heading">
    <div class="panel-head">
      <div>
        <span class="section-label">Location Finder</span>
        <h2 class="section-title" id="locations-heading">Choose Your <span>Store</span></h2>
      </div>
      <div class="result-count" data-result-count>{locations.length} locations</div>
    </div>
    <div class="selected-banner" data-selected-banner>
      Selected store: <strong data-selected-store-name>Select Location</strong>. Ordering links will use this store until changed.
    </div>
    <div class="controls">
      <label class="search-input" aria-label="Search Pizza World locations">
        <input type="search" data-location-search placeholder="Search by city, state, ZIP, or store name">
      </label>
      <button class="use-location" type="button" data-use-location>Use Current Location</button>
    </div>
    <div class="filters">
      <select class="state-filter" data-state-filter aria-label="Filter by state">
        <option value="all">All States</option>
        {states.map((state) => <option value={state}>{state}</option>)}
      </select>
      <button class="quick-filter active" type="button" data-status-filter="all">All</button>
      <button class="quick-filter" type="button" data-status-filter="Open">Open Now</button>
      <button class="quick-filter" type="button" data-status-filter="Coming Soon">Coming Soon</button>
    </div>
    <p class="status-line" data-status-line>Tip: pick a store first so Order Now sends customers to the right FoodTec page.</p>
    <div class="no-results" data-no-results>No matching locations found. Try a city like Branson, a state like IL, or a ZIP code.</div>
    <div class="locations-list" data-location-list>
      {locations.map((location) => (
        <article class="location-card" data-location-card data-location-id={location.id}>
          <div class="location-main">
            <div class="meta-row">
              <span class:list={['pill', location.status === 'Open' ? 'open' : 'soon']}>{location.status}</span>
              <span class="pill">{location.type}</span>
              <span class="pill">{location.state}</span>
            </div>
            <h2>{location.name}</h2>
            <p>{location.address}<br>{location.city}, {location.state} {location.zip}</p>
            {location.phone ? <p><a class="text-link" href={`tel:${location.phone.replace(/\D/g, '')}`}>{location.phone}</a> - {location.hours}</p> : <p>{location.hours}</p>}
            <a class="text-link" target="_blank" rel="noopener" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${location.address}, ${location.city}, ${location.state} ${location.zip}`)}`}>Get Directions</a>
            <div class="card-actions">
              <button class="small-btn" type="button" data-select-location={location.id}>Choose This Store</button>
              {location.orderUrl ? <button class="small-btn primary" type="button" data-order-location={location.id}>Order Now</button> : <button class="small-btn" type="button" disabled>Coming Soon</button>}
            </div>
          </div>
          <div class="distance" data-distance-for={location.id}>-- miles</div>
        </article>
      ))}
    </div>
  </section>
  <aside class="map-panel" aria-label="Pizza World location map">
    <div class="map-card" data-map-card>
      <div class="map-summary">
        <h2 data-map-title>{activeLocations.length} Online Ordering Stores</h2>
        <p data-map-copy>Select a pin or a location card to preview the store. Use current location to sort by nearest Pizza World.</p>
      </div>
      {locations.map((location) => (
        <button class="map-pin" type="button" data-map-pin={location.id} data-lat={location.lat} data-lng={location.lng} aria-label={`Select ${location.name}`}>
          <span>{location.name}</span>
        </button>
      ))}
    </div>
  </aside>
</main>

<div class="modal" data-order-modal aria-hidden="true">
  <div class="modal-backdrop" data-close-modal></div>
  <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="confirm-title">
    <h2 id="confirm-title">Confirm Your Store</h2>
    <p>You are about to order from <span class="modal-location" data-modal-location>Pizza World</span>.</p>
    <div class="modal-actions">
      <button type="button" data-close-modal>Change Store</button>
      <button class="confirm" type="button" data-confirm-order>Continue To Order</button>
    </div>
  </div>
</div>

<script type="application/json" id="location-data" set:html={JSON.stringify(locations)}></script>
<script>
(function(){
  var dataNode = document.getElementById('location-data');
  var locations = dataNode ? JSON.parse(dataNode.textContent || '[]') : [];
  var storageKey = 'pw_selected_location';
  var searchInput = document.querySelector('[data-location-search]');
  var stateFilter = document.querySelector('[data-state-filter]');
  var statusFilters = Array.prototype.slice.call(document.querySelectorAll('[data-status-filter]'));
  var cards = Array.prototype.slice.call(document.querySelectorAll('[data-location-card]'));
  var pins = Array.prototype.slice.call(document.querySelectorAll('[data-map-pin]'));
  var resultCount = document.querySelector('[data-result-count]');
  var statusLine = document.querySelector('[data-status-line]');
  var noResults = document.querySelector('[data-no-results]');
  var selectedBanner = document.querySelector('[data-selected-banner]');
  var modal = document.querySelector('[data-order-modal]');
  var modalLocation = document.querySelector('[data-modal-location]');
  var confirmOrder = document.querySelector('[data-confirm-order]');
  var mapTitle = document.querySelector('[data-map-title]');
  var mapCopy = document.querySelector('[data-map-copy]');
  var activeStatus = 'all';
  var userCoords = null;
  var pendingOrderLocation = null;

  function getLocation(id) {
    return locations.find(function(location){ return location.id === id; });
  }

  function fullAddress(location) {
    return [location.address, location.city, location.state, location.zip].filter(Boolean).join(', ');
  }

  function calculateDistance(lat1, lng1, lat2, lng2) {
    var earthRadius = 3959;
    var dLat = (lat2 - lat1) * Math.PI / 180;
    var dLng = (lng2 - lng1) * Math.PI / 180;
    var a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
      Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
      Math.sin(dLng / 2) * Math.sin(dLng / 2);
    return earthRadius * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  }

  function setMapPinPositions() {
    if (!pins.length || !locations.length) return;
    var lats = locations.map(function(location){ return location.lat; });
    var lngs = locations.map(function(location){ return location.lng; });
    var minLat = Math.min.apply(Math, lats);
    var maxLat = Math.max.apply(Math, lats);
    var minLng = Math.min.apply(Math, lngs);
    var maxLng = Math.max.apply(Math, lngs);
    pins.forEach(function(pin){
      var lat = parseFloat(pin.getAttribute('data-lat'));
      var lng = parseFloat(pin.getAttribute('data-lng'));
      var x = 8 + ((lng - minLng) / (maxLng - minLng || 1)) * 84;
      var y = 88 - ((lat - minLat) / (maxLat - minLat || 1)) * 72;
      pin.style.left = x + '%';
      pin.style.top = y + '%';
    });
  }

  function updateDistances() {
    cards.forEach(function(card){
      var location = getLocation(card.getAttribute('data-location-id'));
      var distanceNode = card.querySelector('[data-distance-for]');
      if (!location || !distanceNode) return;
      if (!userCoords) {
        distanceNode.textContent = '-- miles';
        card.dataset.distance = '999999';
        return;
      }
      var miles = calculateDistance(userCoords.lat, userCoords.lng, location.lat, location.lng);
      distanceNode.textContent = miles.toFixed(1) + ' miles';
      card.dataset.distance = String(miles);
    });
  }

  function sortByDistance() {
    if (!userCoords) return;
    var list = document.querySelector('[data-location-list]');
    cards.sort(function(a,b){
      return parseFloat(a.dataset.distance || '999999') - parseFloat(b.dataset.distance || '999999');
    });
    cards.forEach(function(card){ list.appendChild(card); });
  }

  function updateFilters() {
    var query = (searchInput ? searchInput.value : '').trim().toLowerCase();
    var selectedState = stateFilter ? stateFilter.value : 'all';
    var visibleCount = 0;
    cards.forEach(function(card){
      var location = getLocation(card.getAttribute('data-location-id'));
      if (!location) return;
      var haystack = [location.name, location.address, location.city, location.state, location.zip, location.type].join(' ').toLowerCase();
      var matchesQuery = !query || haystack.indexOf(query) !== -1;
      var matchesState = selectedState === 'all' || location.state === selectedState;
      var matchesStatus = activeStatus === 'all' || location.status === activeStatus;
      var visible = matchesQuery && matchesState && matchesStatus;
      card.style.display = visible ? '' : 'none';
      visibleCount += visible ? 1 : 0;
    });
    pins.forEach(function(pin){
      var location = getLocation(pin.getAttribute('data-map-pin'));
      if (!location) return;
      var haystack = [location.name, location.address, location.city, location.state, location.zip, location.type].join(' ').toLowerCase();
      var visible = (!query || haystack.indexOf(query) !== -1) &&
        (selectedState === 'all' || location.state === selectedState) &&
        (activeStatus === 'all' || location.status === activeStatus);
      pin.style.display = visible ? '' : 'none';
    });
    if (resultCount) resultCount.textContent = visibleCount + (visibleCount === 1 ? ' location' : ' locations');
    if (noResults) noResults.classList.toggle('open', visibleCount === 0);
  }

  function setSelected(location, options) {
    if (!location) return;
    localStorage.setItem(storageKey, JSON.stringify(location));
    document.querySelectorAll('[data-selected-store-name]').forEach(function(node){
      node.textContent = location.name;
    });
    if (selectedBanner) selectedBanner.classList.add('open');
    cards.forEach(function(card){ card.classList.toggle('selected', card.getAttribute('data-location-id') === location.id); });
    pins.forEach(function(pin){ pin.classList.toggle('active', pin.getAttribute('data-map-pin') === location.id); });
    if (mapTitle) mapTitle.textContent = location.name;
    if (mapCopy) mapCopy.textContent = fullAddress(location) + (location.phone ? ' - ' + location.phone : '');
    if (options && options.scroll) {
      var card = document.querySelector('[data-location-card][data-location-id="' + location.id + '"]');
      if (card) card.scrollIntoView({behavior:'smooth',block:'center'});
    }
  }

  function loadSelected() {
    try {
      var stored = JSON.parse(localStorage.getItem(storageKey) || 'null');
      if (stored && stored.id) setSelected(getLocation(stored.id) || stored);
    } catch (error) {}
  }

  function openOrderModal(location) {
    if (!location || !location.orderUrl) {
      if (statusLine) statusLine.textContent = 'That location is marked Coming Soon, so online ordering is not active yet.';
      return;
    }
    pendingOrderLocation = location;
    setSelected(location);
    if (modalLocation) modalLocation.textContent = location.name;
    if (modal) {
      modal.classList.add('open');
      modal.setAttribute('aria-hidden','false');
    }
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.remove('open');
    modal.setAttribute('aria-hidden','true');
  }

  document.addEventListener('click', function(event){
    var selectButton = event.target.closest('[data-select-location]');
    if (selectButton) {
      setSelected(getLocation(selectButton.getAttribute('data-select-location')), {scroll:false});
      if (statusLine) statusLine.textContent = 'Selected ' + getLocation(selectButton.getAttribute('data-select-location')).name + '. Order Now buttons use that store.';
      return;
    }
    var orderButton = event.target.closest('[data-order-location]');
    if (orderButton) {
      openOrderModal(getLocation(orderButton.getAttribute('data-order-location')));
      return;
    }
    var pin = event.target.closest('[data-map-pin]');
    if (pin) {
      setSelected(getLocation(pin.getAttribute('data-map-pin')), {scroll:true});
      return;
    }
    if (event.target.closest('[data-order-selected]')) {
      var selected = null;
      try { selected = JSON.parse(localStorage.getItem(storageKey) || 'null'); } catch (error) {}
      if (!selected) {
        if (statusLine) statusLine.textContent = 'Choose a Pizza World location first, then Order Now will go to that store.';
        document.querySelector('[data-location-list]').scrollIntoView({behavior:'smooth',block:'start'});
        return;
      }
      openOrderModal(getLocation(selected.id) || selected);
      return;
    }
    if (event.target.closest('[data-close-modal]')) closeModal();
  });

  if (confirmOrder) {
    confirmOrder.addEventListener('click', function(){
      if (pendingOrderLocation && pendingOrderLocation.orderUrl) {
        window.open(pendingOrderLocation.orderUrl, '_blank', 'noopener');
      }
      closeModal();
    });
  }

  if (searchInput) searchInput.addEventListener('input', updateFilters);
  if (stateFilter) stateFilter.addEventListener('change', updateFilters);
  statusFilters.forEach(function(button){
    button.addEventListener('click', function(){
      activeStatus = button.getAttribute('data-status-filter');
      statusFilters.forEach(function(item){ item.classList.toggle('active', item === button); });
      updateFilters();
    });
  });

  var useLocationButton = document.querySelector('[data-use-location]');
  if (useLocationButton) {
    useLocationButton.addEventListener('click', function(){
      if (!navigator.geolocation) {
        if (statusLine) statusLine.textContent = 'Current location is not supported by this browser.';
        return;
      }
      useLocationButton.textContent = 'Locating...';
      useLocationButton.disabled = true;
      navigator.geolocation.getCurrentPosition(function(position){
        userCoords = {lat: position.coords.latitude, lng: position.coords.longitude};
        updateDistances();
        sortByDistance();
        updateFilters();
        var nearestCard = cards.find(function(card){ return card.style.display !== 'none'; }) || cards[0];
        var nearest = nearestCard ? getLocation(nearestCard.getAttribute('data-location-id')) : null;
        if (nearest) setSelected(nearest);
        if (statusLine) statusLine.textContent = nearest ? 'Nearest store selected: ' + nearest.name + '.' : 'Distances updated from your current location.';
        useLocationButton.textContent = 'Use Current Location';
        useLocationButton.disabled = false;
      }, function(){
        if (statusLine) statusLine.textContent = 'Could not get your current location. You can still search by city, state, or ZIP.';
        useLocationButton.textContent = 'Use Current Location';
        useLocationButton.disabled = false;
      }, {enableHighAccuracy:true,timeout:10000,maximumAge:300000});
    });
  }

  document.addEventListener('keydown', function(event){
    if (event.key === 'Escape') closeModal();
  });

  setMapPinPositions();
  loadSelected();
  updateFilters();
})();
</script>
</body>
</html>
